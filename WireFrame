function rwSearch(query) {
    const resultsEl = document.getElementById('rw-search-results');
    const emptyEl = document.getElementById('rw-search-empty');
    
    if (!query || query.trim().length < 1) {
        emptyEl.style.display = 'block';
        resultsEl.querySelectorAll('.search-result-item').forEach(el => el.remove());
        return;
    }
    
    emptyEl.style.display = 'none';
    resultsEl.querySelectorAll('.search-result-item').forEach(el => el.remove());
    
    const filtered = rwSearchData.filter(d => 
        d.title.includes(query) || d.excerpt.includes(query) || d.cat.includes(query)
    );
    
    if (filtered.length === 0) {
        const noResult = document.createElement('div');
        noResult.className = 'search-result-item';
        noResult.innerHTML = `<div class="text-center py-4 text-slate-400 text-xs">검색 결과가 없습니다</div>`;
        resultsEl.appendChild(noResult);
        return;
    }
    
    filtered.forEach(item => {
        const el = document.createElement('div');
        el.className = 'search-result-item';
        el.innerHTML = `
            <div class="sr-title">${item.title}</div>
            <div class="sr-meta">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-600 ${item.cat === '운영정책' ? 'bg-blue-50 text-blue-600' : item.cat === '상담요약' ? 'bg-purple-50 text-purple-600' : 'bg-amber-50 text-amber-600'}">${item.cat}</span>
            </div>
            <div class="sr-excerpt">${item.excerpt}</div>
        `;
        resultsEl.appendChild(el);
    });
}

function rwApplyFilter(el, keyword) {
    document.querySelectorAll('#rw-saved-filters .saved-filter').forEach(f => f.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('rw-search-input').value = keyword;
    rwSearch(keyword);
}

function toggleNewFilterInput() {
    const input = document.getElementById('rw-new-filter-name');
    const confirmBtn = document.getElementById('rw-save-filter-confirm');
    const isVisible = input.style.display !== 'none';
    input.style.display = isVisible ? 'none' : 'block';
    confirmBtn.style.display = isVisible ? 'none' : 'inline-flex';
    if (!isVisible) {
        const currentSearch = document.getElementById('rw-search-input').value;
        input.value = currentSearch || '';
        input.focus();
    }
}

function saveNewFilter() {
    const name = document.getElementById('rw-new-filter-name').value.trim();
    if (!name) return;
    const container = document.getElementById('rw-saved-filters');
    const el = document.createElement('div');
    el.className = 'saved-filter';
    el.innerHTML = `
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
        ${name}
        <span class="sf-x" onclick="event.stopPropagation();this.parentElement.remove()">×</span>
    `;
    el.onclick = function() { rwApplyFilter(el, name); };
    container.appendChild(el);
