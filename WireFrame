let currentPolicyTab = 'all';
let currentPolicyCat = 'all';
let currentPolicyDetail = null;

function initPolicyPage() {
    renderPolicyList();
    updateBookmarkCount();
}

const POLICY_CAT_STYLES = {
    '해지': { color:'#ef4444', bg:'#fef2f2', icon:'🛡️' },
    '요금': { color:'#f59e0b', bg:'#fffbeb', icon:'💰' },
    '민원': { color:'#8b5cf6', bg:'#faf5ff', icon:'📋' },
    '부가': { color:'#10b981', bg:'#f0fdf4', icon:'⭐' },
    '고객': { color:'#3b82f6', bg:'#eff6ff', icon:'👤' },
    '보안': { color:'#64748b', bg:'#f8fafc', icon:'🔒' },
};
const POLICY_DIFF_STYLES = {
    'HIGH':   { label:'고난도', color:'#ef4444', bg:'#fef2f2' },
    'NORMAL': { label:'보통',   color:'#f59e0b', bg:'#fffbeb' },
    'EASY':   { label:'쉬움',   color:'#10b981', bg:'#f0fdf4' },
};

function getFilteredPolicies() {
    let list = POLICIES;
    const q = document.getElementById('policySearchInput')?.value?.toLowerCase() || '';
    if (q) list = list.filter(p => p.title.toLowerCase().includes(q) || p.tags.some(t => t.toLowerCase().includes(q)) || p.summary.toLowerCase().includes(q));
    if (currentPolicyCat !== 'all') list = list.filter(p => p.category === currentPolicyCat);
    if (currentPolicyTab === 'bookmark') list = list.filter(p => policyBookmarks.has(p.id));
    return list;
}

function renderPolicyList() {
    const list = getFilteredPolicies();
    const isBookmarkTab = currentPolicyTab === 'bookmark';
    const container = isBookmarkTab ? document.getElementById('policyBookmarkContainer') : document.getElementById('policyListContainer');
    const otherContainer = isBookmarkTab ? document.getElementById('policyListContainer') : document.getElementById('policyBookmarkContainer');
    container.style.display = 'block';
    otherContainer.style.display = 'none';

    if (list.length === 0) {
        container.innerHTML = `<div class="empty-state"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg><p style="font-size:14px;font-weight:600;color:#64748b;">${isBookmarkTab ? '북마크한 정책이 없습니다' : '검색 결과가 없습니다'}</p><p style="font-size:13px;color:#94a3b8;margin-top:4px;">${isBookmarkTab ? '정책 목록에서 ⭐ 버튼으로 북마크하세요' : '다른 키워드로 검색해보세요'}</p></div>`;
        return;
    }

    container.innerHTML = `<div class="overflow-x-auto"><table class="tbl">
        <thead><tr>
            <th style="width:36px;">☆</th>
            <th style="width:90px;">카테고리</th>
            <th>정책명</th>
            <th style="width:80px;">난이도</th>
            <th style="width:180px;">태그</th>
            <th style="width:60px;">조회</th>
            <th style="width:100px;">등록일</th>
        </tr></thead>
        <tbody>
        ${list.map(p => {
            const cat = POLICY_CAT_STYLES[p.category] || { color:'#64748b', bg:'#f8fafc', icon:'📄' };
            const diff = POLICY_DIFF_STYLES[p.difficulty] || POLICY_DIFF_STYLES['NORMAL'];
            const isBookmarked = policyBookmarks.has(p.id);
            return `<tr onclick="openPolicyDetail('${p.id}')">
                <td style="text-align:center;">
                    <button onclick="event.stopPropagation();toggleBookmark('${p.id}')" style="background:none;border:none;cursor:pointer;font-size:16px;padding:0;">${isBookmarked ? '⭐' : '☆'}</button>
                </td>
                <td><span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:6px;background:${cat.bg};color:${cat.color};white-space:nowrap;">${cat.icon} ${p.category}</span></td>
                <td>
                    <div style="font-size:13px;font-weight:600;color:#0f172a;line-height:1.3;">${p.title}</div>
                    <div style="font-size:11.5px;color:#94a3b8;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px;">${p.summary}</div>
                </td>
                <td><span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px;background:${diff.bg};color:${diff.color};">${diff.label}</span></td>
                <td><div style="display:flex;gap:4px;flex-wrap:wrap;">${p.tags.slice(0,2).map(t => `<span style="font-size:10px;padding:2px 7px;border-radius:999px;background:#f1f5f9;color:#475569;">${t}</span>`).join('')}${p.tags.length > 2 ? `<span style="font-size:10px;color:#94a3b8;">+${p.tags.length-2}</span>` : ''}</div></td>
                <td style="font-size:12px;color:#94a3b8;">👁 ${p.views}</td>
                <td style="font-size:12px;color:#94a3b8;">${p.date}</td>
            </tr>`;
        }).join('')}
        </tbody></table></div>
        <div style="padding:12px 16px;border-top:1px solid #f1f5f9;font-size:12px;color:#94a3b8;">총 ${list.length}건</div>`;
}

function switchPolicyTab(tab) {
    currentPolicyTab = tab;
    document.getElementById('policyTabAll').classList.toggle('active', tab==='all');
    document.getElementById('policyTabBookmark').classList.toggle('active', tab==='bookmark');
    renderPolicyList();
}

function filterPolicyCategory(cat, el) {
    currentPolicyCat = cat;
    document.querySelectorAll('#policyCategoryChips .cat-chip').forEach(c => c.classList.remove('active'));
    if (el) el.classList.add('active');
    renderPolicyList();
}

function filterPolicies() { renderPolicyList(); }

function toggleBookmark(id) {
    if (policyBookmarks.has(id)) policyBookmarks.delete(id);
    else policyBookmarks.add(id);
    updateBookmarkCount();
    renderPolicyList();
}

function updateBookmarkCount() {
    const el = document.getElementById('bookmarkCount');
    if (el) el.textContent = policyBookmarks.size;
}

function openPolicyDetail(id) {
    const p = POLICIES.find(x => x.id === id);
    if (!p) return;
    currentPolicyDetail = p;
    const cat = POLICY_CAT_STYLES[p.category] || { color:'#64748b', bg:'#f8fafc', icon:'📄' };
    const diff = POLICY_DIFF_STYLES[p.difficulty] || POLICY_DIFF_STYLES['NORMAL'];
    const isBookmarked = policyBookmarks.has(p.id);

    document.getElementById('pdCatBadge').textContent = cat.icon + ' ' + p.category;
    document.getElementById('pdCatBadge').style.cssText = `font-size:11px;font-weight:700;padding:3px 10px;border-radius:6px;background:${cat.bg};color:${cat.color};`;
    document.getElementById('pdDiffBadge').textContent = diff.label;
    document.getElementById('pdDiffBadge').style.cssText = `font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px;background:${diff.bg};color:${diff.color};`;
    document.getElementById('pdDate').textContent = p.date;
    document.getElementById('pdTitle').textContent = p.title;
    document.getElementById('pdSummary').textContent = p.summary;
    document.getElementById('pdGuideContent').innerHTML = p.guide;

    // 북마크 버튼
    document.getElementById('pdBookmarkIcon').textContent = isBookmarked ? '⭐' : '☆';
    const btn = document.getElementById('pdBookmarkBtn');
    btn.style.borderColor = isBookmarked ? '#f59e0b' : '#e2e8f0';
    btn.style.background = isBookmarked ? '#fffbeb' : '#fff';
    btn.style.color = isBookmarked ? '#92400e' : '#64748b';

    // 스크립트
    const scriptSection = document.getElementById('pdScriptSection');
    const scriptContainer = document.getElementById('pdScripts');
    if (p.scripts && p.scripts.length > 0) {
        scriptSection.style.display = 'block';
        scriptContainer.innerHTML = p.scripts.map(s => `
            <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;margin-bottom:10px;">
                <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
                    <span style="width:20px;height:20px;border-radius:50%;background:#e2e8f0;color:#64748b;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">Q</span>
                    <div style="font-size:13px;color:#64748b;line-height:1.6;">${s.q}</div>
                </div>
                <div style="display:flex;align-items:flex-start;gap:8px;">
                    <span style="width:20px;height:20px;border-radius:50%;background:#1e40af;color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">A</span>
                    <div style="font-size:13px;color:#1e3a8a;line-height:1.6;background:#eff6ff;border-radius:8px;padding:10px 12px;flex:1;">${s.a}</div>
                </div>
            </div>
        `).join('');
    } else {
        scriptSection.style.display = 'none';
    }

    // 관련 정책
    const relSection = document.getElementById('pdRelatedSection');
    const relContainer = document.getElementById('pdRelated');
    if (p.related && p.related.length > 0) {
        relSection.style.display = 'block';
        relContainer.innerHTML = p.related.map(rid => {
            const rp = POLICIES.find(x => x.id === rid);
            if (!rp) return '';
            const rc = POLICY_CAT_STYLES[rp.category] || { color:'#64748b', bg:'#f8fafc', icon:'📄' };
            return `<button onclick="openPolicyDetail('${rid}')" style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;cursor:pointer;font-size:12px;font-weight:600;color:#334155;transition:all 0.15s;" onmouseover="this.style.borderColor='${rc.color}';this.style.background='${rc.bg}'" onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#fff'">
                <span style="color:${rc.color};">${rc.icon}</span> ${rp.title.length > 25 ? rp.title.substring(0,25)+'...' : rp.title}
            </button>`;
        }).join('');
    } else {
        relSection.style.display = 'none';
    }

    // 태그
    document.getElementById('pdTagSection').innerHTML = p.tags.map(t => `<span style="font-size:12px;padding:4px 12px;border-radius:999px;background:#f1f5f9;color:#475569;font-weight:500;">#${t}</span>`).join('');

    document.getElementById('policyDetailModal').classList.add('open');
}

function closePolicyDetail() {
    document.getElementById('policyDetailModal').classList.remove('open');
    currentPolicyDetail = null;
}

function toggleBookmarkInDetail() {
    if (!currentPolicyDetail) return;
    toggleBookmark(currentPolicyDetail.id);
    openPolicyDetail(currentPolicyDetail.id);
}

