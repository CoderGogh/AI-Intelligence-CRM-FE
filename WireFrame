function resetPipeline() {
    for (let i = 1; i <= 5; i++) {
        const step = document.getElementById('pipe-' + i);
        const icon = step?.querySelector('.pipe-icon');
        const status = document.getElementById('pipe-' + i + '-status');
        if (step) { step.classList.remove('active','done','skip'); }
        if (icon) { icon.className = 'pipe-icon pipe-pending'; icon.textContent = '①②③④⑤'[i-1]; }
        if (status) { status.textContent = '대기'; status.style.color = '#94a3b8'; }
    }
}

function setPipeStep(n, state, statusText) {
    const step = document.getElementById('pipe-' + n);
    const icon = step?.querySelector('.pipe-icon');
    const status = document.getElementById('pipe-' + n + '-status');
    if (!step) return;
    step.className = 'pipeline-step ' + (state === 'done' ? 'done' : state === 'skip' ? 'skip' : 'active');
    if (icon) {
        icon.className = 'pipe-icon ' + (state === 'done' ? 'pipe-done' : state === 'skip' ? 'pipe-skip' : 'pipe-active');
        icon.textContent = state === 'done' ? '✓' : state === 'skip' ? '—' : '①②③④⑤'[n-1];
    }
    if (status) { status.textContent = statusText; status.style.color = state === 'done' ? '#065f46' : state === 'skip' ? '#92400e' : '#1d4ed8'; }
}

