function updateAdminStats() {
    const el = (id, v) => { const e=document.getElementById(id); if(e) e.textContent=v; };
    el('adminStatTotal',    bpData.length);
    el('adminStatActive',   bpData.filter(d=>d.status==='ACTIVE').length);
    el('adminStatDraft',    bpData.filter(d=>d.status==='DRAFT').length);
    el('adminStatFeatured', bpData.filter(d=>d.featured).length);
}

function filterAdminTable(val) { bpAdminSearchText = val; renderAdminTable(); }
function filterAdminByStatus(v) { renderAdminTable(); }
function filterAdminByCat(v)    { renderAdminTable(); }

function toggleFeatured(id) {
    const d = bpData.find(b=>b.id===id);
    if (!d) return;
    d.featured = !d.featured;
    renderAdminTable();
    filterBPCards();
    showToast(d.featured ? '이달의 사례로 선정되었습니다.' : '이달의 사례 선정이 해제되었습니다.');
}

function deleteBPCase(id) {
    const d = bpData.find(b=>b.id===id);
    if (!d) return;
    if (!confirm('"'+d.title.slice(0,20)+'..." 사례를 삭제하시겠습니까?')) return;
    bpData.splice(bpData.indexOf(d), 1);
    renderAdminTable();
    filterBPCards();
    showToast('사례가 삭제되었습니다.');
}

let bpEditingId = null;

function openBPEditModal(id) {
    bpEditingId = id;
    const modal = document.getElementById('bpEditModal');
    if (!modal) return;
    document.getElementById('bpEditTitle').textContent = id ? '사례 수정' : '새 사례 등록';
    if (id) {
        const d = bpData.find(b=>b.id===id);
        if (!d) return;
        document.getElementById('ef_category').value  = d.category;
        document.getElementById('ef_difficulty').value= d.difficulty;
        document.getElementById('ef_agent').value     = d.agent;
        document.getElementById('ef_status').value    = d.status;
        document.getElementById('ef_title').value     = d.title;
        document.getElementById('ef_summary').value   = d.summary;
        document.getElementById('ef_points').value    = d.points.join('\n');
        document.getElementById('ef_script').value    = d.script.map(s=>'고객: '+s.q+'\n상담사: '+s.a).join('\n\n');
        document.getElementById('ef_result').value    = d.result;
        document.getElementById('ef_tags').value      = (d.tags||[]).join(', ');
        document.getElementById('ef_featured').checked= d.featured;
    } else {
        ['ef_category','ef_title','ef_summary','ef_points','ef_script','ef_result','ef_tags']
            .forEach(i=>{const e=document.getElementById(i);if(e)e.value='';});
        document.getElementById('ef_difficulty').value='NORMAL';
        document.getElementById('ef_status').value='ACTIVE';
        document.getElementById('ef_featured').checked=false;
    }
    modal.classList.add('open');
}

function closeBPEdit() { document.getElementById('bpEditModal').classList.remove('open'); }

function saveBPCase(statusOverride) {
    const cat     = document.getElementById('ef_category').value;
    const title   = document.getElementById('ef_title').value.trim();
    const summary = document.getElementById('ef_summary').value.trim();
    if (!cat || !title || !summary) { alert('카테고리, 제목, 상황 요약은 필수 항목입니다.'); return; }
    const agentName   = document.getElementById('ef_agent').value;
    const agentColors = {'김민수':'#1d4ed8','이지은':'#7c3aed','박준호':'#059669','최수진':'#be185d'};
    const points      = (document.getElementById('ef_points').value.trim()||'').split('\n').filter(Boolean);
    const scriptRaw   = document.getElementById('ef_script').value.trim();
    const scriptBlocks= scriptRaw ? scriptRaw.split(/\n\n+/).map(block=>{
        const lines=block.split('\n');
        const q=lines.find(l=>l.startsWith('고객:'))?.replace('고객:','').trim()||'';
        const a=lines.find(l=>l.startsWith('상담사:'))?.replace('상담사:','').trim()||'';
        return q&&a?{q,a}:null;
    }).filter(Boolean) : [];
    const tags = (document.getElementById('ef_tags').value.trim()||'').split(',').map(t=>t.trim()).filter(Boolean);

    if (bpEditingId) {
        const d = bpData.find(b=>b.id===bpEditingId);
        if (d) Object.assign(d, { category:cat, difficulty:document.getElementById('ef_difficulty').value,
            agent:agentName, agentColor:agentColors[agentName]||'#1d4ed8', agentInit:agentName[0],
            status:statusOverride||document.getElementById('ef_status').value,
            title, summary, points, script:scriptBlocks,
            result:document.getElementById('ef_result').value.trim(), tags,
            featured:document.getElementById('ef_featured').checked });
    } else {
        const newId = Math.max(...bpData.map(b=>b.id))+1;
        bpData.unshift({ id:newId, category:cat, difficulty:document.getElementById('ef_difficulty').value,
            agent:agentName, agentColor:agentColors[agentName]||'#1d4ed8', agentInit:agentName[0],
            status:statusOverride||document.getElementById('ef_status').value,
            title, summary, points, script:scriptBlocks,
            result:document.getElementById('ef_result').value.trim(), tags,
            featured:document.getElementById('ef_featured').checked,
            views:0, likes:0,
            date:new Date().toLocaleDateString('ko-KR',{year:'numeric',month:'2-digit',day:'2-digit'}).replace(/\. /g,'.') });
    }
    closeBPEdit();
    renderAdminTable();
    filterBPCards();
    renderCategoryChips();
    showToast(statusOverride==='DRAFT'?'임시저장 되었습니다.':'사례가 저장되었습니다.');
}

function switchBPRole(role) {
