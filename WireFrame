let bpCurrentCat = '전체';
let bpAdminSearchText = '';
let bpCurrentDetailId = null;

function initBPPage() {
    renderCategoryChips();
    filterBPCards();
    renderAdminTable();
    updateAdminStats();
}

function renderCategoryChips() {
    const cats = ['전체', '해지방어', '불만처리', '가입안내', '보험안내', '민원대응', 'VIP응대'];
    const counts = {};
    bpData.forEach(d => { if (d.status === 'ACTIVE') counts[d.category] = (counts[d.category]||0) + 1; });
    const total = bpData.filter(d => d.status === 'ACTIVE').length;
    const container = document.getElementById('bpCategoryChips');
    if (!container) return;
    container.innerHTML = cats.map(c => {
        const cfg = CAT_CONFIG[c] || CAT_CONFIG['전체'];
        const cnt = c === '전체' ? total : (counts[c]||0);
        const isActive = bpCurrentCat === c;
        return `<button class="cat-chip${isActive?' active':''}" onclick="setBPCat('${c}')"
            style="${isActive ? 'border-color:'+cfg.color+';background:'+cfg.bg+';color:'+cfg.color : ''}">
            ${c} <span class="chip-count" style="${isActive?'background:'+cfg.color+'20;color:'+cfg.color:''}">${cnt}</span>
        </button>`;
    }).join('');
}

function setBPCat(cat) {
    bpCurrentCat = cat;
    renderCategoryChips();
    filterBPCards();
}

function filterBPCards() {
    const keyword = (document.getElementById('bpSearchInput')?.value || '').toLowerCase();
    const sort    = document.getElementById('bpSortSelect')?.value || 'latest';
    const diff    = document.getElementById('bpDiffSelect')?.value || '';

    let list = bpData.filter(d => d.status === 'ACTIVE');
    if (bpCurrentCat !== '전체') list = list.filter(d => d.category === bpCurrentCat);
    if (diff) list = list.filter(d => d.difficulty === diff);
    if (keyword) list = list.filter(d =>
        d.title.toLowerCase().includes(keyword) ||
        d.summary.toLowerCase().includes(keyword) ||
        d.agent.toLowerCase().includes(keyword) ||
        (d.tags||[]).some(t => t.toLowerCase().includes(keyword))
    );
    if (sort === 'views') list.sort((a,b) => b.views - a.views);
    else if (sort === 'likes') list.sort((a,b) => b.likes - a.likes);
    else list.sort((a,b) => b.id - a.id);

    const featured = list.filter(d => d.featured);
    const rest     = list.filter(d => !d.featured);
    const featSec  = document.getElementById('bpFeaturedSection');
    const featCards= document.getElementById('bpFeaturedCards');
    const showFeat = featured.length && bpCurrentCat === '전체' && !keyword && !diff;
    if (featSec) featSec.style.display = showFeat ? 'block' : 'none';
    if (featCards) featCards.innerHTML = featured.map(d => renderBPCard(d, true)).join('');

    const grid    = document.getElementById('bpCardGrid');
    const empty   = document.getElementById('bpEmptyState');
    const countEl = document.getElementById('bpListCount');
    const titleEl = document.getElementById('bpListTitle');
    const showList= (bpCurrentCat === '전체' && !keyword && !diff) ? rest : list;
    if (countEl) countEl.textContent = showList.length + '건';
    if (titleEl) titleEl.textContent = (bpCurrentCat !== '전체' || keyword || diff)
        ? (bpCurrentCat !== '전체' ? bpCurrentCat : keyword || diff) + ' 검색 결과'
        : '전체 사례';
    if (grid) {
        if (showList.length === 0) { grid.innerHTML=''; if(empty) empty.style.display='block'; }
        else { if(empty) empty.style.display='none'; grid.innerHTML=showList.map(d=>renderBPCard(d,false)).join(''); }
    }
}

