// 더미 알림 데이터 (user_notifications 테이블 모사)
let NOTIF_DATA = [
    { id:1, type:'NOTICE', ref_id:1, message:'[긴급] 2월 시스템 점검 안내', is_read:false, created_at:'2025-02-01 09:00', icon:'🔔' },
