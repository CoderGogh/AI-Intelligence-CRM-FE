let wizStep = 1;
let wizSelectedId = null;
let wizDifficulty = 'NORMAL';

function openWizard() {
    wizStep = 1;
    wizSelectedId = null;
    wizDifficulty = 'NORMAL';
    document.querySelectorAll('.wiz-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('wiz-step-1').classList.add('active');
    document.getElementById('wiz-analysis-result').style.display = 'none';
    document.getElementById('wiz-empty').style.display = 'block';
    document.getElementById('wiz-btn-prev').style.display = 'none';
    document.getElementById('wiz-btn-next').innerHTML = '다음 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>';
    updateWizStepUI();
    document.getElementById('bpWizardModal').classList.add('open');
}

function closeWizard() {
    document.getElementById('bpWizardModal').classList.remove('open');
}

function updateWizStepUI() {
    [1,2,3].forEach(i => {
        const num = document.getElementById('wiz-num-'+i);
        const lbl = document.getElementById('wiz-lbl-'+i);
        if (!num||!lbl) return;
        if (i < wizStep) {
            num.className='wiz-step-num done'; num.textContent='✓'; lbl.className='wiz-step-label done';
        } else if (i===wizStep) {
            num.className='wiz-step-num active'; num.textContent=i; lbl.className='wiz-step-label active';
        } else {
            num.className='wiz-step-num pending'; num.textContent=i; lbl.className='wiz-step-label pending';
        }
    });
    [1,2].forEach(i => {
        const con = document.getElementById('wiz-con-'+i);
        if (!con) return;
        if (i < wizStep-1)       con.className='wiz-connector done';
        else if (i===wizStep-1)  con.className='wiz-connector active';
        else                     con.className='wiz-connector pending';
    });
}

function wizNext() {
    if (wizStep===1) {
        if (!wizSelectedId) { showToast('우수 상담을 선택해주세요.'); return; }
        wizStep=2; fillStep2();
    } else if (wizStep===2) {
        if (!document.getElementById('wiz_category').value ||
            !document.getElementById('wiz_title').value.trim() ||
            !document.getElementById('wiz_summary').value.trim()) {
            showToast('카테고리, 제목, 요약은 필수입니다.'); return;
        }
        wizStep=3; fillStep3();
        document.getElementById('wiz-btn-next').innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> 게시하기';
    } else if (wizStep===3) {
        saveFromWizard(); return;
    }
    document.querySelectorAll('.wiz-panel').forEach(p=>p.classList.remove('active'));
    document.getElementById('wiz-step-'+wizStep).classList.add('active');
    document.getElementById('wiz-btn-prev').style.display = wizStep>1?'flex':'none';
    updateWizStepUI();
}

function wizPrev() {
    if (wizStep<=1) return;
    wizStep--;
    document.querySelectorAll('.wiz-panel').forEach(p=>p.classList.remove('active'));
    document.getElementById('wiz-step-'+wizStep).classList.add('active');
    document.getElementById('wiz-btn-prev').style.display=wizStep>1?'flex':'none';
    if (wizStep<3) document.getElementById('wiz-btn-next').innerHTML='다음 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>';
    updateWizStepUI();
}

