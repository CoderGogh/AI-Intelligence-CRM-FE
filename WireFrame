        if (statusFilter && d.status !== statusFilter) return false;
        if (catFilter && d.category !== catFilter) return false;
        if (bpAdminSearchText) {
            const q = bpAdminSearchText.toLowerCase();
            return d.title.toLowerCase().includes(q) || d.agent.toLowerCase().includes(q);
        }
        return true;
    });
    const tbody   = document.getElementById('bpAdminTbody');
    const countEl = document.getElementById('bpAdminCount');
    if (!tbody) return;
    if (countEl) countEl.textContent = '전체 ' + list.length + '건';
    const statusLabel = { ACTIVE:'게시중', DRAFT:'임시저장', HIDDEN:'숨김' };
    const statusCls   = { ACTIVE:'bp-status-active', DRAFT:'bp-status-draft', HIDDEN:'bp-status-hidden' };
    tbody.innerHTML = list.map(d => {
        const cfg  = CAT_CONFIG[d.category] || CAT_CONFIG['전체'];
