      <!-- Empty state (before load) -->
      <div id="wiz-empty" style="text-align:center;padding:48px 20px;color:#94a3b8;">
        <svg style="width:48px;height:48px;margin:0 auto 16px;opacity:0.35;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <p style="font-size:14px;font-weight:600;margin-bottom:6px;">분석 조회를 실행하세요</p>
        <p style="font-size:13px;">기간과 조건을 설정하고 분석 조회 버튼을 누르면<br>AI가 우수 상담을 추천해드립니다</p>
      </div>
    </div>

    <!-- ════ STEP 2 : 관리자 설명 추가 ════ -->
    <div class="wiz-panel" id="wiz-step-2" style="max-height:72vh;">
      <div class="wiz-split">

        <!-- 좌: 선택된 상담 원문 요약 -->
        <div>
          <div style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:12px;">📋 선택된 상담 내역</div>
          <div id="wiz-selected-preview"></div>
        </div>

        <!-- 우: 관리자 입력 -->
        <div>
          <div style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:12px;">✏️ 관리자 설명 추가</div>

          <div style="margin-bottom:14px;">
            <label class="form-label">카테고리 *</label>
            <select class="form-input form-select" style="font-size:13px;" id="wiz_category">
              <option value="">선택</option>
              <option>해지방어</option><option>불만처리</option><option>가입안내</option>
              <option>보험안내</option><option>민원대응</option><option>VIP응대</option>
            </select>
          </div>

          <div style="margin-bottom:14px;">
            <label class="form-label">사례 제목 *</label>
            <input type="text" class="form-input" style="font-size:13px;" placeholder="상황을 한 문장으로 표현하세요" id="wiz_title">
          </div>

          <div style="margin-bottom:14px;">
            <label class="form-label">상황 요약 <span style="font-size:11px;color:#94a3b8;font-weight:400;text-transform:none;">(AI 요약 기반, 수정 가능)</span></label>
            <textarea class="form-input" rows="3" style="font-size:13px;resize:vertical;" id="wiz_summary"></textarea>
          </div>

          <div style="margin-bottom:14px;">
            <label class="form-label">핵심 포인트 <span style="font-size:11px;color:#94a3b8;font-weight:400;text-transform:none;">(줄바꿈 구분)</span></label>
            <textarea class="form-input" rows="4" style="font-size:13px;resize:vertical;" placeholder="예: 고객 감정 공감 우선 → 방어적 태도 해소&#10;해지 손실 금액 수치로 구체 제시&#10;대안 3가지 순차 제안" id="wiz_points"></textarea>
          </div>

          <div style="margin-bottom:14px;">
            <label class="form-label">난이도</label>
            <div style="display:flex;gap:8px;">
              <label style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px;border:1.5px solid #e2e8f0;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;color:#ef4444;transition:all 0.15s;" id="diff-high" onclick="setWizDiff('HIGH')">
                <span style="width:8px;height:8px;border-radius:50%;background:#ef4444;display:inline-block;"></span>고난도
              </label>
              <label style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px;border:1.5px solid #e2e8f0;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;color:#f59e0b;transition:all 0.15s;" id="diff-normal" onclick="setWizDiff('NORMAL')">
                <span style="width:8px;height:8px;border-radius:50%;background:#f59e0b;display:inline-block;"></span>보통
              </label>
              <label style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px;border:1.5px solid #e2e8f0;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;color:#10b981;transition:all 0.15s;" id="diff-easy" onclick="setWizDiff('EASY')">
                <span style="width:8px;height:8px;border-radius:50%;background:#10b981;display:inline-block;"></span>쉬움
              </label>
            </div>
          </div>

          <div style="margin-bottom:14px;">
            <label class="form-label">태그 <span style="font-size:11px;color:#94a3b8;font-weight:400;text-transform:none;">(쉼표 구분)</span></label>
            <input type="text" class="form-input" style="font-size:13px;" placeholder="예: VIP, 해지방어, 감액완납" id="wiz_tags">
          </div>

          <div style="padding:12px 14px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;display:flex;align-items:center;gap:10px;">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;font-weight:600;color:#92400e;">
              <input type="checkbox" id="wiz_featured" style="width:15px;height:15px;accent-color:#f59e0b;">
              🏆 이달의 우수 사례 선정
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- ════ STEP 3 : 미리보기 ════ -->
    <div class="wiz-panel" id="wiz-step-3" style="max-height:72vh;">
      <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
        <svg style="width:15px;height:15px;color:#10b981;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        상담사에게 보여질 모습 미리보기
      </div>

      <div style="display:grid;grid-template-columns:340px 1fr;gap:20px;">
        <!-- 카드 미리보기 -->
        <div>
          <div style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;">카드 뷰</div>
          <div id="wiz-preview-card"></div>
        </div>

        <!-- 상세 미리보기 -->
        <div>
          <div style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;">상세 내용</div>
          <div id="wiz-preview-detail" style="border:1px solid #e2e8f0;border-radius:12px;padding:18px;font-size:13px;overflow-y:auto;max-height:400px;"></div>
        </div>
      </div>

      <div style="margin-top:16px;padding:14px 18px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:#065f46;font-weight:600;">
          <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          저장 후 상담사 조회 화면에 즉시 반영됩니다
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#065f46;cursor:pointer;">
            <input type="checkbox" id="wiz_notify" checked style="accent-color:#10b981;">
            상담사 알림 발송
          </label>
        </div>
      </div>
    </div>

    <!-- Footer nav -->
    <div class="wiz-footer">
      <button class="btn btn-secondary" id="wiz-btn-prev" onclick="wizPrev()" style="display:none;">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        이전
      </button>
      <div style="flex:1;"></div>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-secondary" onclick="closeWizard()">취소</button>
        <button class="btn btn-primary" id="wiz-btn-next" onclick="wizNext()">
          다음
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

</body>
</html>
