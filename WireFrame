    document.getElementById('wiz-empty').style.display='none';
    document.getElementById('wiz-analysis-result').style.display='none';
    setTimeout(()=>{
        let pool = ANALYSIS_POOL.filter(d=>d.csatScore>=csat);
        if (agent) pool=pool.filter(d=>d.agent===agent);
        if (type)  pool=pool.filter(d=>d.type===type);
        const aiAvg=Math.round(pool.reduce((s,d)=>s+d.aiScore,0)/(pool.length||1));
