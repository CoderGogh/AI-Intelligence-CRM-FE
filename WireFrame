    // 기존 토스트 제거
    const existing = document.getElementById('newNoticeToast');
    if (existing) existing.remove();
    
    const toast = document.createElement('div');
    toast.id = 'newNoticeToast';
    toast.style.cssText = `
        position:fixed;top:16px;right:16px;z-index:99999;
        background:linear-gradient(135deg,#1e293b,#0f172a);
        border:1px solid rgba(255,255,255,0.15);border-left:4px solid ${typeColor};
        border-radius:12px;padding:14px 18px;min-width:320px;max-width:400px;
        box-shadow:0 8px 32px rgba(0,0,0,0.4);
        animation:slideInRight 0.4s ease;
        display:flex;align-items:flex-start;gap:12px;
    `;
    toast.innerHTML = `
        <div style="width:32px;height:32px;border-radius:8px;background:${typeColor}20;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg fill="none" stroke="${typeColor}" viewBox="0 0 24 24" style="width:16px;height:16px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        </div>
        <div style="flex:1;">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                <span style="font-size:10px;font-weight:700;color:#fff;background:${typeColor};padding:1px 7px;border-radius:999px;">${typeLabel}</span>
                <span style="font-size:10px;color:#64748b;">새 공지사항</span>
            </div>
            <div style="font-size:13px;font-weight:600;color:#f1f5f9;line-height:1.4;">${title}</div>
            <div style="display:flex;align-items:center;gap:8px;margin-top:8px;">
                <button onclick="showPage('notice');document.getElementById('newNoticeToast')?.remove();" style="font-size:11px;color:#3b82f6;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.3);border-radius:6px;padding:3px 10px;cursor:pointer;font-weight:600;">바로 보기</button>
                <button onclick="document.getElementById('newNoticeToast')?.remove();" style="font-size:11px;color:#64748b;background:none;border:none;cursor:pointer;">닫기</button>
            </div>
        </div>
        <button onclick="document.getElementById('newNoticeToast')?.remove();" style="color:#475569;background:none;border:none;cursor:pointer;padding:0;flex-shrink:0;">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:14px;height:14px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
    `;
    document.body.appendChild(toast);
    
    // 알림 데이터에 추가
    const newNotif = {
        id: NOTIF_DATA.length + 1,
        type: 'NOTICE',
        ref_id: NOTIF_DATA.length + 1,
        message: title,
        is_read: false,
        created_at: new Date().toLocaleString('ko-KR'),
        icon: type === 'URGENT' ? '🚨' : '🔔'
    };
    NOTIF_DATA.unshift(newNotif);
    updateNotifBadge();
    
    // 공지 페이지 배너 갱신
    const bannerText = document.querySelector('#noticeAlertBanner .text-sm');
    const bannerSub = document.querySelector('#noticeAlertBanner .text-xs');
    if (bannerText) bannerText.textContent = '새 공지가 등록되었습니다';
    if (bannerSub) bannerSub.textContent = title + ' — 방금 전';
    const banner = document.getElementById('noticeAlertBanner');
    if (banner) banner.style.display = 'block';
    
    // 8초 후 자동 닫기
    setTimeout(() => { const t = document.getElementById('newNoticeToast'); if(t) t.remove(); }, 8000);
}

// ═══════════════════════════════════════════════════════════════
//  우수사례 등록 모달 (best_practices 테이블 기반)
// ═══════════════════════════════════════════════════════════════
function openBpForm() {
    // 기존 3단계 위저드 모달 열기 (bpWizardModal)
    const m = document.getElementById('bpWizardModal');
    if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    else {
        // fallback: 단순 모달
        const m2 = document.getElementById('bpFormModal');
        if (m2) { m2.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    }
}
function closeBpForm() {
    const m = document.getElementById('bpWizardModal');
    if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
    const m2 = document.getElementById('bpFormModal');
    if (m2) { m2.style.display = 'none'; document.body.style.overflow = ''; }
}
function submitBpForm() {
    const title = document.getElementById('bpf_title')?.value?.trim();
    if (!title) { alert('제목을 입력해주세요'); return; }
    // 더미 데이터에 추가 (실제로는 POST /api/best-practices)
    showToast('✅ 우수사례가 등록되었습니다');
    closeBpForm();
    // 알림 트리거 (등록 시 상담사에게 알림 발송 시뮬레이션)
    triggerNewNoticeAlert('새 우수사례: ' + title, 'GENERAL');
    // notif 데이터 타입 수정
    NOTIF_DATA[0].type = 'BEST_PRACTICE';
    NOTIF_DATA[0].icon = '⭐';
    NOTIF_DATA[0].message = '새 우수사례 등록: ' + title;
    renderNotifList();
}

// ═══════════════════════════════════════════════════════════════
//  알림 설정 토글 (user_notification_settings 연동)
// ═══════════════════════════════════════════════════════════════
function toggleNotifSetting(key) {
    NOTIF_SETTINGS[key] = !NOTIF_SETTINGS[key];
    const el = document.getElementById('ns_' + key);
    if (el) {
        el.style.background = NOTIF_SETTINGS[key] ? '#3b82f6' : '#cbd5e1';
        el.querySelector('span').style.transform = NOTIF_SETTINGS[key] ? 'translateX(20px)' : 'translateX(2px)';
    }
    showToast(NOTIF_SETTINGS[key] ? '알림이 켜졌습니다' : '알림이 꺼졌습니다');
}

function initNotifSettingUI() {
    ['notify_notice','notify_best_practice','notify_policy_change'].forEach(key => {
        const el = document.getElementById('ns_' + key);
        if (!el) return;
        el.style.background = NOTIF_SETTINGS[key] ? '#3b82f6' : '#cbd5e1';
        if (el.querySelector('span')) el.querySelector('span').style.transform = NOTIF_SETTINGS[key] ? 'translateX(20px)' : 'translateX(2px)';
    });
}

</script>

