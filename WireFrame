        document.getElementById('wiz-period-label').textContent=df+' ~ '+dt+(agent?' · '+agent:'');
        const cats={};
        pool.forEach(d=>d.keywords.forEach(kw=>{cats[kw]=(cats[kw]||0)+1;}));
        document.getElementById('wiz-insights').innerHTML=[
            {icon:'🏆',text:pool.length+'건의 우수 상담 후보 발굴',       c:'#1e40af',bg:'#eff6ff'},
            {icon:'📈',text:'AI 품질 평균 '+aiAvg+'점 (기준 80점 초과)', c:'#065f46',bg:'#f0fdf4'},
