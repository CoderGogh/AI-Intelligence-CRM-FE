function renderConversation(caseId) {
    const body = document.getElementById('conversationBody');
    if (!body) return;
    
    // SUMMARY_DATA에서 원문 발췌가 있으면 사용, 아니면 CONVERSATION_DATA
    const convData = CONVERSATION_DATA[caseId];
    const summaryItem = typeof SUMMARY_DATA !== 'undefined' ? SUMMARY_DATA.find(s => s.id === caseId) : null;
    
    if (convData && convData.length > 0) {
        document.getElementById('convMsgCount').textContent = convData.length + '건';
        body.innerHTML = convData.map(msg => {
            if (msg.role === 'system') {
                return `<div style="text-align:center;margin:12px 0;">
                    <span style="font-size:10px;color:#94a3b8;background:#f1f5f9;padding:3px 12px;border-radius:999px;">${msg.time} · ${msg.text}</span>
                </div>`;
            }
            const isCustomer = msg.role === 'customer';
            return `<div style="display:flex;gap:10px;margin-bottom:12px;${isCustomer?'':'flex-direction:row-reverse;'}">
                <div style="width:30px;height:30px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;background:${isCustomer?'#64748b':'#1e40af'};">
                    ${isCustomer?'고':'상'}
                </div>
                <div style="max-width:70%;">
                    <div style="font-size:10px;color:#94a3b8;margin-bottom:3px;${isCustomer?'':'text-align:right;'}">${isCustomer?'고객':'상담사'} · ${msg.time}</div>
                    <div style="padding:10px 14px;border-radius:${isCustomer?'2px 12px 12px 12px':'12px 2px 12px 12px'};background:${isCustomer?'#fff':'#eff6ff'};border:1px solid ${isCustomer?'#e2e8f0':'#bfdbfe'};font-size:12px;color:#334155;line-height:1.7;">
                        ${msg.text}
                    </div>
                </div>
            </div>`;
        }).join('');
    } else {
        // 대화 데이터 없을 때
        document.getElementById('convMsgCount').textContent = '0건';
        body.innerHTML = `<div style="text-align:center;padding:40px 20px;">
            <svg style="width:40px;height:40px;color:#cbd5e1;margin:0 auto 12px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <div style="font-size:13px;color:#94a3b8;font-weight:600;">원문 대화 데이터 없음</div>
            <div style="font-size:11px;color:#cbd5e1;margin-top:4px;">해당 상담 건의 녹취/채팅 로그가 아직 저장되지 않았습니다.</div>
        </div>`;
    }
}

