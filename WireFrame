                <div style="font-size:11px;color:#94a3b8;margin-top:2px;">${(d.tags||[]).map(t=>'#'+t).join(' ')}</div>
            </td>
            <td>
                <div style="display:flex;align-items:center;gap:6px;">
                    <div style="width:22px;height:22px;border-radius:50%;background:${d.agentColor};color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;">${d.agentInit}</div>
