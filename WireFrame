        const adminPages = ['employees'];
        const currentPage = document.querySelector('.page.active')?.id?.replace('page-','');
        if (adminPages.includes(currentPage)) showPage('list');
    }
    if (role === 'admin') {
        const agentPages = ['send-result'];
        const currentPage = document.querySelector('.page.active')?.id?.replace('page-','');
        if (agentPages.includes(currentPage)) showPage('list');
    }
}

function showPage(page) {
    // 관리자 전용 페이지 체크
    if (page === 'employees' && currentRole !== 'admin') return;
    if (page === 'send-result' && currentRole === 'admin') { showToast('결과서 전송은 상담사 전용 기능입니다'); return; }
    
    document.querySelectorAll('.page').forEach(p => { p.classList.remove('active'); p.style.display='none'; });
    document.querySelectorAll('.nav-item, .nav-sub-item').forEach(n => n.classList.remove('active'));
    const el = document.getElementById('page-' + page);
    const main = document.getElementById('mainContent');
    if (el) {
        // result-write 페이지는 flex(좌우 분할)로 표시, main도 flex 높이 고정
        if (page === 'send-result') {
            el.style.display = 'flex';
            if (main) { main.style.overflow = 'hidden'; main.style.height = '100vh'; }
        } else {
            el.style.display = 'block';
            if (main) { main.style.overflow = 'auto'; main.style.height = ''; }
        }
        el.classList.add('active');
    }
    
    // Nav highlight by id
    const navId = 'nav-' + page;
    const navEl = document.getElementById(navId);
    if (navEl) navEl.classList.add('active');

    // 검색 페이지 호환 (search → summary)
    if (page === 'search') { showPage('summary'); return; }

    const isPolicyPage = page === 'policy' || page === 'policy-customer';
    if (isPolicyPage) {
        openPolicySubMenu();
        document.getElementById('nav-policy-parent')?.classList.add('active');
        if (page === 'policy') document.getElementById('nav-policy-manual')?.classList.add('active');
        if (page === 'policy-customer') document.getElementById('nav-policy-customer')?.classList.add('active');
    }
    
    if (page === 'analytics') initCharts();
    if (page === 'summary') initSummaryPage();
    if (page === 'bestpractice') initBPPage();
    if (page === 'policy') initPolicyPage();
    if (page === 'policy-customer') initCustomerTypePage();
    if (page === 'notice') initNoticePage();
    if (page === 'employees') initEmployeesPage();
    if (page === 'myaccount') renderMyBookmarks();
    if (page === 'send-result') { /* send result page init */ loadRandomResult(); }
}

