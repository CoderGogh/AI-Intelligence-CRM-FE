];

// 알림 설정 (user_notification_settings 테이블 모사)
let NOTIF_SETTINGS = {
    notify_notice: true,
    notify_best_practice: true,
    notify_policy_change: false
};

function getUnreadCount() {
    return NOTIF_DATA.filter(n => !n.is_read).length;
}

function updateNotifBadge() {
    const cnt = getUnreadCount();
    const badge = document.getElementById('notifBadge');
    const label = document.getElementById('notifBadgeLabel');
    if (!badge) return;
    if (cnt > 0) {
        badge.style.display = 'flex';
        badge.textContent = cnt > 9 ? '9+' : cnt;
        if (label) { label.style.display = 'inline'; label.textContent = cnt; }
        // 사이드바 nav-notice 뱃지
        const dot = document.getElementById('noticeNewDot');
        if (dot) dot.style.display = 'inline-block';
    } else {
        badge.style.display = 'none';
        if (label) label.style.display = 'none';
        const dot = document.getElementById('noticeNewDot');
        if (dot) dot.style.display = 'none';
    }
}

function renderNotifList() {
    const el = document.getElementById('notifList');
    if (!el) return;
    updateNotifBadge();
    const filtered = NOTIF_DATA.filter(n => {
        if (n.type === 'NOTICE' && !NOTIF_SETTINGS.notify_notice) return false;
        if (n.type === 'BEST_PRACTICE' && !NOTIF_SETTINGS.notify_best_practice) return false;
        if (n.type === 'POLICY_CHANGE' && !NOTIF_SETTINGS.notify_policy_change) return false;
        return true;
    });
    if (filtered.length === 0) {
        el.innerHTML = '<div style="padding:24px;text-align:center;color:#64748b;font-size:12px;">알림이 없습니다</div>';
        return;
    }
    el.innerHTML = filtered.map(n => `
        <div onclick="readNotif(${n.id})" style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.06);cursor:pointer;display:flex;gap:10px;align-items:flex-start;background:${n.is_read ? 'transparent' : 'rgba(59,130,246,0.08)'};transition:background 0.15s;" onmouseenter="this.style.background='rgba(255,255,255,0.05)'" onmouseleave="this.style.background='${n.is_read ? 'transparent' : 'rgba(59,130,246,0.08)'}'">
            <div style="width:28px;height:28px;border-radius:8px;background:${n.is_read ? '#334155' : '#1d4ed8'};display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;">${n.icon}</div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:12px;color:${n.is_read ? '#94a3b8' : '#f1f5f9'};font-weight:${n.is_read ? '400' : '600'};line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${n.message}</div>
                <div style="font-size:10px;color:#475569;margin-top:2px;">${n.created_at}</div>
            </div>
            ${!n.is_read ? '<div style="width:6px;height:6px;border-radius:50%;background:#3b82f6;flex-shrink:0;margin-top:4px;"></div>' : ''}
        </div>
    `).join('');
}

function readNotif(id) {
    const n = NOTIF_DATA.find(x => x.id === id);
    if (n) n.is_read = true;
    renderNotifList();
    // 공지 관련이면 공지 페이지로 이동
    if (n && n.type === 'NOTICE') { showPage('notice'); toggleNotifPanel(); }
    if (n && n.type === 'BEST_PRACTICE') { showPage('bestpractice'); toggleNotifPanel(); }
    if (n && n.type === 'POLICY_CHANGE') { showPage('policy'); toggleNotifPanel(); }
}

function markAllNotifRead() {
    NOTIF_DATA.forEach(n => n.is_read = true);
    renderNotifList();
}

let notifPanelOpen = false;
function toggleNotifPanel() {
    const panel = document.getElementById('notifPanel');
    if (!panel) return;
    notifPanelOpen = !notifPanelOpen;
    panel.style.display = notifPanelOpen ? 'block' : 'none';
    if (notifPanelOpen) renderNotifList();
}
// 외부 클릭 시 닫기
document.addEventListener('click', function(e) {
    const panel = document.getElementById('notifPanel');
    if (!panel || !notifPanelOpen) return;
    if (!panel.contains(e.target) && !e.target.closest('[onclick="toggleNotifPanel()"]')) {
        notifPanelOpen = false;
        panel.style.display = 'none';
    }
});

