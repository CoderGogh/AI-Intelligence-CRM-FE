function initEmployeesPage() {
    const tbody = document.getElementById('empTbody');
    if (!tbody) return;
    tbody.innerHTML = EMPLOYEES.map(e => `
        <tr>
            <td onclick="event.stopPropagation()"><input type="checkbox" class="rounded" ${e.isSelf?'disabled':''}></td>
            <td>
                <div class="flex items-center gap-3">
                    <div class="emp-avatar ${e.color}">${e.name[0]}</div>
                    <div>
                        <div class="font-600 text-slate-800 text-sm">${e.name} ${e.isSelf?'<span class="text-xs text-blue-500">(본인)</span>':''}</div>
                    </div>
                </div>
            </td>
            <td class="mono text-xs text-slate-500">${e.id}</td>
            <td class="text-sm text-slate-600">${e.login}</td>
            <td class="text-sm text-slate-600">${e.dept}</td>
            <td><span class="badge" style="background:${e.role==='관리자'?'#dbeafe':'#f1f5f9'};color:${e.role==='관리자'?'#1e40af':'#374151'};">${e.role}</span></td>
            <td><span class="badge ${e.status==='재직'?'emp-status-active':'emp-status-inactive'}">${e.status}</span></td>
            <td class="text-xs text-slate-400 mono">${e.date}</td>
            <td>
                <div style="display:flex;gap:4px;">
                    <button class="btn btn-secondary btn-xs" onclick="openEmpForm('detail','${e.id}')">상세</button>
                    <button class="btn btn-secondary btn-xs" onclick="openEmpForm('edit','${e.id}')">수정</button>
                    ${e.isSelf ? '' : '<button class="btn btn-xs" style="background:#fee2e2;color:#991b1b;" onclick="deleteEmployee(\''+e.id+'\')">삭제</button>'}
                </div>
            </td>
        </tr>
    `).join('');
}

function openEmpForm(mode, id) {
    if (mode === 'new') {
        showToast('👤 직원 등록 폼 (패스워드 등록 시에만 설정, 랜덤 8자 생성 기능)');
    } else if (mode === 'detail') {
        const emp = EMPLOYEES.find(e => e.id === id);
        showToast('📋 ' + (emp?.name||'') + ' 상세 정보 (MNG_EMP_03)');
    } else {
        showToast('✏️ 직원 정보 수정 (MNG_EMP_01)');
    }
}
function deleteEmployee(id) {
    const emp = EMPLOYEES.find(e => e.id === id);
    if (emp?.isSelf) { showToast('본인의 계정은 삭제할 수 없습니다'); return; }
    showToast('🗑️ ' + (emp?.name||'') + ' 삭제 처리 (MNG_EMP_04)');
}

