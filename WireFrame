function closeBPDetail() { document.getElementById('bpDetailModal').classList.remove('open'); }

function toggleBPLike() {
    const d = bpData.find(b => b.id === bpCurrentDetailId);
    if (!d) return;
    d._liked = !d._liked;
    d.likes += d._liked ? 1 : -1;
    document.getElementById('bpLikeBtn').classList.toggle('liked', d._liked);
    document.getElementById('bpLikeCount').textContent = d.likes;
    filterBPCards();
}

